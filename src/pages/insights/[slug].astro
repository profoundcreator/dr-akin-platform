---
import Layout from "@/layouts/Layout.astro";
import { InsightDetailBySlug } from "@/components/pages/insight-detail-by-slug";
import { fetchAllInsightsForBuild } from "@/lib/insights/articles-build";

export async function getStaticPaths() {
  const articles = await fetchAllInsightsForBuild();

  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
---

<Layout title={`${article.title} — Insights`} description={article.summary} ogImage={article.heroImageUrl ?? undefined}>
  <InsightDetailBySlug client:load slug={article.slug} initialInsight={article} />
</Layout>
