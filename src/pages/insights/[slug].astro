---
import Layout from "@/layouts/Layout.astro";
import { InsightArticlePage } from "@/components/pages/marketing-page";
import { INSIGHT_ARTICLES } from "@/data/site-content";

export function getStaticPaths() {
  return INSIGHT_ARTICLES.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
---

<Layout title={`${article.title} — Insights`} description={article.summary}>
  <InsightArticlePage
    client:load
    title={article.title}
    category={article.category}
    date={article.date}
    body={article.body}
  />
</Layout>
