---
import Layout from "@/layouts/Layout.astro";
import { InsightArticlePage } from "@/components/pages/marketing-page";
import { fetchAllInsightsForBuild } from "@/lib/insights/articles-build";

export async function getStaticPaths() {
  const articles = await fetchAllInsightsForBuild();

  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
---

<Layout title={`${article.title} — Insights`} description={article.summary} ogImage={article.heroImageUrl ?? undefined}>
  <InsightArticlePage
    client:load
    title={article.title}
    category={article.category}
    date={article.publishedAt ?? article.createdAt}
    body={article.body}
    heroImageUrl={article.heroImageUrl}
    sourceLabel={article.sourceLabel}
    sourceUrl={article.sourceUrl}
  />
</Layout>
