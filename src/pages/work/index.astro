---
import Layout from "@/layouts/Layout.astro";
import { WorkHubPage } from "@/components/pages/work-hub-page";
import { SITE_PAGES } from "@/data/site-content";
import { SITE_IMAGES } from "@/lib/media/site-images";
import { fetchAllWorkOrgsForBuild } from "@/lib/work-orgs/orgs-build";

const content = SITE_PAGES["work"];
const orgs = await fetchAllWorkOrgsForBuild();
---

<Layout
  title={content.title}
  description={content.description}
  ogImage={SITE_IMAGES.portraitApproachable}
  preloadImage={SITE_IMAGES.portraitApproachable}
>
  <WorkHubPage client:load content={content} initialOrgs={orgs} />
</Layout>
