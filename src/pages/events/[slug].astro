---
import Layout from "@/layouts/Layout.astro";
import { EventDetailBySlug } from "@/components/pages/event-detail-by-slug";
import { fetchPublishedEventsForBuild } from "@/lib/events/events-build";
import { applyStaticEventCoverFallback, getEventCoverUrl, getEventMetaDescription } from "@/lib/events/events";
import { breadcrumbSchema, eventSchema } from "@/lib/seo/json-ld";

export async function getStaticPaths() {
  const events = await fetchPublishedEventsForBuild();

  return events.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

const { event: rawEvent } = Astro.props;
const event = applyStaticEventCoverFallback(rawEvent);
const description = getEventMetaDescription(event);
const coverUrl = getEventCoverUrl(event.coverImagePath);
const site = Astro.site ?? Astro.url.origin;
const schemas = [
  eventSchema({ ...event, image: coverUrl }, site),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Events", path: "/events" },
    { name: event.title, path: `/events/${event.slug}` },
  ], site),
];
---

<Layout
  title={`${event.title} — Events`}
  description={description}
  ogImage={coverUrl ?? undefined}
  ogImageAlt={event.title}
  jsonLd={schemas}
>
  <EventDetailBySlug client:load slug={event.slug} initialEvent={event} />
</Layout>
