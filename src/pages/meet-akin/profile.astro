---
import Layout from "@/layouts/Layout.astro";
import { ProfilePage } from "@/components/pages/profile-page";
import { SITE_PAGES } from "@/data/site-content";
import { SITE_IMAGES } from "@/lib/media/site-images";
import { personSchema } from "@/lib/seo/json-ld";

const content = SITE_PAGES["meet-profile"];
const site = Astro.site ?? Astro.url.origin;
---

<Layout
  title={content.title}
  description={content.description}
  ogType="profile"
  ogImage={SITE_IMAGES.portraitFormal}
  preloadImage={SITE_IMAGES.portraitFormal}
  jsonLd={personSchema(site)}
>
  <ProfilePage client:load />
</Layout>
