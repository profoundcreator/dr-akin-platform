{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.theakinakinpelu.org" }],
      "destination": "https://theakinakinpelu.org/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [{ "type": "host", "value": "www.theakinakinpelu.org" }],
      "destination": "https://theakinakinpelu.org/:path+",
      "permanent": true
    },
    {
      "source": "/work/tc-resource-technology",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "/admin/login",
      "permanent": false
    },
    {
      "source": "/insights/view",
      "has": [{ "type": "query", "key": "slug", "value": "(?<slug>.+)" }],
      "destination": "/insights/:slug",
      "permanent": true
    },
    {
      "source": "/events/view",
      "has": [{ "type": "query", "key": "slug", "value": "(?<slug>.+)" }],
      "destination": "/events/:slug",
      "permanent": true
    },
    {
      "source": "/library/view",
      "has": [{ "type": "query", "key": "slug", "value": "(?<slug>.+)" }],
      "destination": "/library/:slug",
      "permanent": true
    },
    {
      "source": "/work/view",
      "has": [{ "type": "query", "key": "slug", "value": "(?<slug>.+)" }],
      "destination": "/work/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/booking/:ref", "destination": "/booking/DAA-8492" }
  ]
}
