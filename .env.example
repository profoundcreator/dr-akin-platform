# Supabase — copy to .env and fill in your project values
# Get these from: https://supabase.com/dashboard/project/_/settings/api

PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Vercel deploy hook — triggers a production rebuild when admins publish content (SEO + new static URLs)
# Create in Vercel → Project → Settings → Git → Deploy Hooks, then paste the URL here.
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/your-hook-id

# Public site URL — used for admin invite email redirects and notification links
PUBLIC_SITE_URL=https://dr-akin-platform.vercel.app

# Service role key — required for Team email invites and /api/notify-submission (server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Transactional email (Resend) ---
# Domain verification (theakinakinpelu.org SPF/DKIM) is required before production sends.
RESEND_API_KEY=re_xxxxxxxx
NOTIFICATION_FROM_EMAIL=notifications@theakinakinpelu.org
NOTIFICATION_REPLY_TO=ea@theakinakinpelu.org

# Primary ops inbox — booking alerts and contact fallback
ADMIN_NOTIFICATION_EMAIL=ea@theakinakinpelu.org

# Brand inboxes — contact enquiries routed by platform (?platform= or referrer)
NOTIFY_AALD=hello@aaldcompany.org
NOTIFY_PERFORMX=performx@aaldcompany.org
NOTIFY_ERUDIO=hello@erudiohub.org
NOTIFY_AUCTUS=info@auctusafrica.org

# Optional — media/general enquiries when no platform context is set
NOTIFY_GENERAL=hello@theakinakinpelu.org

# Optional — CC ea@ on brand-routed contact enquiries (default: false)
NOTIFY_EA_COPY_ON_BRAND=false

# Submitter acknowledgement emails (contact + booking)
SEND_SUBMITTER_CONFIRMATION=true

# Optional — GET /api/notifications-status health probe (?key=...)
NOTIFICATIONS_STATUS_KEY=choose-a-long-random-string
